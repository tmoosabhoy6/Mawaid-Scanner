PORT=3000
HOST=0.0.0.0
# Use distinct passwords (12+ characters recommended) and a random 32+ character sync token.
ADMIN_PASSWORD=
SCANNER_PASSWORD=
SYNC_TOKEN=
# Exact HTTPS origin, no trailing slash. localhost permitted for local verification only.
APP_ORIGIN=http://localhost:3000
DATA_DIR=.data
# Set to 1 behind one trusted HTTPS reverse proxy; leave 0 for local HTTP.
TRUST_PROXY=0
