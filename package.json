{
  "name": "mawayid-karbala",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/app.js && node --check public/app.js && node --check apps-script/ToursSync.js && node --check cloudflare/worker.js",
    "build:cloudflare": "npm run build && cf build",
    "deploy:cloudflare": "npm run build && cf deploy"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "html5-qrcode": "^2.3.8",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "qz-tray": "^2.2.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.3",
    "@napi-rs/canvas": "1.0.12",
    "cf": "0.15.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "miniflare": "5.20261019.1-beta",
    "supertest": "^7.1.4",
    "vite": "8.3.4"
  }
}
